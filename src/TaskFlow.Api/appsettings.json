{
  "Logging": {
    "LogLevel": {
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RequestTiming": {
    "SlowRequestThresholdMs": 500,
    "AddResponseHeader": true
  },
  "Diagnostics": {
    "Enabled": false
  }
}